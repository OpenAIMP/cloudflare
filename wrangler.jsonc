{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-search-chat-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "<YOUR_KV_NAMESPACE_ID>"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "AI_SEARCH_ENDPOINT": "https://aisearch.openaimp.com",
    "APP_NAME": "AI Search Chat Agent"
  }
}
